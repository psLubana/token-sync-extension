{
  "manifest_version": 3,
  "name": "Token Sync",
  "version": "1.3",
  "description": "Copies the JWT token from a dev/sys/uat tab into a localhost tab.",
  "permissions": ["scripting", "tabs", "clipboardWrite"],
  "host_permissions": ["*://*.example.com/*", "*://localhost/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Token Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
